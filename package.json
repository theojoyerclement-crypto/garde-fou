{
  "name": "gardefou",
  "version": "0.2.0",
  "description": "Garde-Fou : audit de sécurité local pour les projets générés par IA (secrets, .env, Supabase RLS, Firebase, routes API, dépendances). Local security audit for AI-generated projects.",
  "type": "module",
  "bin": {
    "gardefou": "dist/cli.js",
    "garde-fou": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "fixture": "tsx scripts/generate-fixture.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "security",
    "secrets",
    "audit",
    "cli",
    "ai",
    "vibe-coding",
    "supabase",
    "firebase",
    "osv",
    "nextjs",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theojoyerclement-crypto/garde-fou.git"
  },
  "homepage": "https://github.com/theojoyerclement-crypto/garde-fou#readme",
  "bugs": {
    "url": "https://github.com/theojoyerclement-crypto/garde-fou/issues"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "ignore": "^7.0.14",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
